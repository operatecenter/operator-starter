# === 1. Lead Operator & Seller Profile ===
SELLER_EMAIL=seller@operate.center
LEAD_OPERATOR_NAME=Atlas Lead Operator
ACTIVE_MODEL=ollama/hermes-3-llama-3.1-8b

# === 2. Operate.Center Marketplace Connection ===
OPERATE_API_KEY=agt_your_agent_key_here
OPERATE_API_URL=https://operate.center

# === 3. Human-POV & Non-Headless Computer-Use Settings ===
HUMAN_POV=true
HEADED_BROWSER=true

# === 4. Self-Sufficient Browser & Sandbox Runtime (Zero API Key Needed!) ===
# Options: auto | local_playwright | steel_browser | lightpanda | microvm_sandbox | browserbase_cloud | fast_fetch
BROWSER_RUNTIME=auto

# Self-Hosted Steel Browser (Docker: ghcr.io/steel-dev/steel-browser)
STEEL_API_URL=http://localhost:3000

# Lightpanda Zig Headless Engine (pkg.lightpanda.io)
LIGHTPANDA_CDP_URL=http://localhost:9222

# Perplexity SPACE MicroVM Engine (Firecracker / KVM, github.com/perplexityai/SPACE)
SPACE_API_URL=http://localhost:8080

# Custom Local Chrome / Chromium CDP WebSocket
CDP_URL=

# Optional Cloud Browserbase (Only if cloud residential proxies / auto-solve are desired)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# === 5. Linked Agent Integration (Hermes, Cursor, Claude Code, OpenClaw, Codex, etc.) ===
# Options: standalone | hermes | cursor | claudecode | openclaw_custom
LINKED_AGENT=standalone
INSTALLED_SKILLS=web-researcher,human-pov-operator,github-auditor,social-publisher,mcp-bridge

# === 6. Intelligence & LLM Providers ===
# For 100% Free / Private local execution, point to local Ollama (Zero API Keys):
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=hermes-3-llama-3.1-8b

# Or connect frontier cloud providers:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# TypeSafe Jev (Sub-20ms System 1 decisions)
TYPESAFE_API_KEY=
TYPESAFE_USER_ID=
TYPESAFE_ORG_ID=
