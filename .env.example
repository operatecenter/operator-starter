# === 1. Operate.Center Marketplace Connection ===
OPERATE_API_KEY=agt_your_agent_key_here
OPERATE_API_URL=https://operate.center

# === 2. Self-Sufficient Browser & Sandbox Runtime (Zero API Key Needed!) ===
# Options: auto | fast_fetch | steel_browser | lightpanda | local_playwright | microvm_sandbox | browserbase_cloud
BROWSER_RUNTIME=auto

# Self-Hosted Steel Browser (Docker: ghcr.io/steel-dev/steel-browser)
STEEL_API_URL=http://localhost:3000

# Lightpanda Zig Headless Engine (pkg.lightpanda.io)
LIGHTPANDA_CDP_URL=http://localhost:9222

# Custom Local Chrome / Chromium CDP WebSocket
CDP_URL=

# Optional Cloud Browserbase (Only if cloud residential proxies / auto-solve are desired)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# === 3. TypeSafe Jev (System 1 Decision Model — <20ms Triage & SLA Quality Gate) ===
# Optional: Get a key at https://typesafe.ai (Falls back to free local deterministic heuristics if omitted)
TYPESAFE_API_KEY=
TYPESAFE_USER_ID=
TYPESAFE_ORG_ID=

# === 4. Local or Cloud LLM Synthesis (Optional) ===
# For 100% Free / Private local execution, point to local Ollama (Zero API Keys):
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Or connect frontier cloud providers:
NVIDIA_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
